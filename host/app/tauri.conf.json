{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ninjoy",
  "identifier": "app.ninjoy.desktop",
  "build": {
    "frontendDist": "../../desktop/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev --workspace @ninjoy/desktop",
    "beforeBuildCommand": "npm run build --workspace @ninjoy/desktop"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/32x32.png"
    ]
  }
}
